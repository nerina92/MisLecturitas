<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <application
        android:name=".MisLecturitasApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MisLecturitas"
        tools:targetApi="31">
        <activity
            android:name=".ui.playread.PlayReadActivity"
            android:exported="false"
            android:label="@string/title_activity_play_read"
            android:theme="@style/Theme.MisLecturitas" />
        <activity
            android:name=".ui.bookList.BookListActivity"
            android:exported="false"
            android:label="@string/title_activity_book_list"
            android:theme="@style/Theme.MisLecturitas" />
        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.MisLecturitas">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:label="@string/title_activity_main" />
        <activity
            android:name=".ui.opciones.OpcionesActivity"
            android:exported="false"
            android:label="Opciones"
            android:theme="@style/Theme.MisLecturitas" />
        <activity
            android:name=".ui.juegos.JuegosActivity"
            android:exported="false"
            android:label="Juegos"
            android:theme="@style/Theme.MisLecturitas" />
        <activity
            android:name=".ui.juegos.FormasActivity"
            android:exported="false"
            android:label="Juego de Formas"
            android:theme="@style/Theme.MisLecturitas" />
        <activity
            android:name=".ui.juegos.RompecabezasActivity"
            android:exported="false"
            android:label="Juego de Rompecabezas"
            android:theme="@style/Theme.MisLecturitas" />
        <activity
            android:name=".ui.audiolibros.AudioLibrosActivity"
            android:exported="false"
            android:label="Audiolibros"
            android:theme="@style/Theme.MisLecturitas" />
        <activity
            android:name=".ui.audiolibros.VideoPlayerActivity"
            android:exported="false"
            android:label="Reproductor de Video"
            android:theme="@style/Theme.MisLecturitas"
            android:screenOrientation="sensor" />
        <activity
            android:name=".ui.admin.AdminMainActivity"
            android:exported="false"
            android:label="Administración"
            android:theme="@style/Theme.MisLecturitas" />
        <activity
            android:name=".ui.admin.AdminActivity"
            android:exported="false"
            android:label="Cargar Contenido"
            android:theme="@style/Theme.MisLecturitas" />
        <activity
            android:name=".ui.admin.ManageContentActivity"
            android:exported="false"
            android:label="Gestionar Contenido"
            android:theme="@style/Theme.MisLecturitas" />
    </application>

</manifest>