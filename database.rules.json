{
  "rules": {
    ".read": false,
    ".write": false,

    "usuarios": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId",

        "progress": {
          ".read": "auth != null && auth.uid == $userId",
          ".write": "auth != null && auth.uid == $userId"
        },

        "achievements": {
          ".read": "auth != null && auth.uid == $userId",
          ".write": "auth != null && auth.uid == $userId"
        },

        "avatar": {
          ".read": "auth != null && auth.uid == $userId",
          ".write": "auth != null && auth.uid == $userId"
        },

        "tipo": {
          ".read": "auth != null",
          ".write": false
        }
      }
    },

    "libros": {
      ".read": "auth != null",
      "$bookId": {
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() == 1"
      }
    },

    "audiolibros": {
      ".read": "auth != null",
      "$audioId": {
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() == 1"
      }
    },

    "juegos": {
      ".read": "auth != null",
      "$gameId": {
        ".write": "auth != null && root.child('usuarios').child(auth.uid).child('tipo').val() == 1"
      }
    }
  }
}
